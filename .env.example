# このファイルを .env にコピーして使う（.env は Git に入れない）
#   cp .env.example .env

# local / production
APP_ENV=local
# true にするとエラー内容を画面に出す。本番では必ず false
APP_DEBUG=true
APP_URL=http://localhost:8080
# システムの名前。変えたいときだけ
# APP_NAME=MINATO BRIDGE

# メールの送り方。mail = サーバーの mail() で送る（本番）、log = 送らずに storage/mail/ に書く（ローカル）
MAIL_DRIVER=log

# ローカル（Docker）ではこのままでOK。本番は Xserver のMySQL設定の値を入れる
DB_HOST=db
DB_PORT=3306
DB_NAME=minato_event
DB_USER=minato
DB_PASSWORD=minato
# Docker の MariaDB 初期化にだけ使う（アプリからは使わない）
DB_ROOT_PASSWORD=root
