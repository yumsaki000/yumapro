# 本番（Xserver）へ反映するときの接続先。make deploy・make server-… が読む
# 次の1行で写してから、値を書き換える（.deploy.env は Git に入れない）
#   cp .deploy.env.example .deploy.env

# ~/.ssh/config の Host に書いた名前
DEPLOY_HOST=minato

# サーバーの中のアプリの置き場所（ホームフォルダからの場所）
DEPLOY_PATH=minatocrew.com/minato-event

# サーバーの PHP 8.3 の場所（サーバーに入って ls /usr/bin/php* で確かめる）
DEPLOY_PHP=/usr/bin/php8.3

# 本番の URL（反映のあと /health で動いているか確かめる）
DEPLOY_URL=https://event.minatocrew.com
